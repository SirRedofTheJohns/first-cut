# Copy to `.env` and fill in. `.env` is git-ignored — never commit it.

# --- LLM ---------------------------------------------------------------
# Provider: ollama | groq | google_genai | huggingface | anthropic | openai
LLM_PROVIDER=ollama
# Qwen3-8B pulled straight from the Hugging Face Hub: `ollama pull hf.co/Qwen/Qwen3-8B-GGUF:Q8_0`
LLM_MODEL=hf.co/Qwen/Qwen3-8B-GGUF:Q8_0
LLM_TEMPERATURE=0.3

# --- Local WordPress (docker compose) -------------------------------------
# Used by docker compose to install WordPress and by the agent to log in.
WP_URL=http://localhost:8080
WP_USER=admin
WP_ADMIN_PASSWORD=change-me-local-only
WP_ADMIN_EMAIL=admin@example.com
# Printed by the `wpcli` service on first `docker compose up`.
WP_APP_PASSWORD=
